<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.apa.athan-app</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <!-- caffeinate holds the Mac awake for exactly as long as the program it
         runs stays alive, then lets go.
           -i  no idle sleep      -m  no disk idle sleep
           -s  no sleep on AC power
         Deliberately NOT -d, which also keeps the DISPLAY awake: the screen
         would stay lit every night for no benefit to prayer times. Add the d
         back (caffeinate -dims) if you want the display kept on too. -->
    <string>caffeinate -ims "__APP_BINARY__"</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__APP_DIR__</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Not <true/>. That relaunches the app the instant it exits, for ANY
       reason, so Quit in the menu bar does nothing you can see: launchd puts
       it straight back. SuccessfulExit=false keeps the useful half — a crash
       is still restarted, because an athan that dies at 3am and stays dead is
       worse than useless — while a clean Quit is respected until you open it
       again or log in again. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>__STDOUT_LOG__</string>

  <key>StandardErrorPath</key>
  <string>__STDERR_LOG__</string>
</dict>
</plist>
